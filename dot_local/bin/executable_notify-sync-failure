#!/usr/bin/env bash
set -Eeuo pipefail

title=${1:-"Automatic sync failed"}
message=${2:-"Inspect the Dagu logs, or start 'dagu server' to use the web UI."}

notify_linux() {
  if command -v notify-send >/dev/null 2>&1 && notify-send "$title" "$message"; then
    return 0
  fi

  echo "Warning: could not deliver desktop notification with notify-send." >&2
  return 1
}

notify_macos() {
  if [[ -x /usr/bin/osascript ]] && /usr/bin/osascript - "$title" "$message" <<'APPLESCRIPT'
on run argv
  display notification (item 2 of argv) with title (item 1 of argv)
end run
APPLESCRIPT
  then
    return 0
  fi

  echo "Warning: could not deliver desktop notification with osascript." >&2
  return 1
}

case $(uname -s) in
  Linux) notify_linux || true ;;
  Darwin) notify_macos || true ;;
  *) echo "Warning: desktop notifications are unsupported on $(uname -s)." >&2 ;;
esac

# Notification delivery must never replace the original workflow failure.
exit 0
