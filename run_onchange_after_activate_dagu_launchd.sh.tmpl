#!/usr/bin/env bash
set -Eeuo pipefail

# Restart when either the agent or its stable launcher changes.
# agent: {{ include "Library/LaunchAgents/com.hossainemruz.dagu.plist.tmpl" | sha256sum }}
# launcher: {{ include "dot_local/bin/executable_dagu-scheduler" | sha256sum }}

export PATH="$HOME/.local/bin:$HOME/.local/share/mise/shims:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin"

if ! command -v dagu >/dev/null 2>&1; then
  echo "Error: dagu is required before activating its LaunchAgent. Run 'mise install dagu', then run 'chezmoi apply' again." >&2
  exit 1
fi

label=com.hossainemruz.dagu
domain="gui/$(id -u)"
plist="$HOME/Library/LaunchAgents/$label.plist"

mkdir -p "$HOME/.local/share/dagu"

if /bin/launchctl print "$domain/$label" >/dev/null 2>&1; then
  /bin/launchctl bootout "$domain" "$plist"
fi

/bin/launchctl enable "$domain/$label"
/bin/launchctl bootstrap "$domain" "$plist"
/bin/launchctl kickstart -k "$domain/$label"
