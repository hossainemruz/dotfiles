[user]
	signingkey = {{ .personal.gitSigningKey }}
	name = Emruz Hossain
	email = {{ .personal.email }}
[core]
	sshCommand = ssh -i {{ .personal.sshIdentityFile }} -o IdentitiesOnly=yes
[commit]
	gpgsign = true
[tag]
	gpgSign = true
[credential "https://gist.github.com"]
   helper = !gh auth git-credential
[url "ssh://git@github.com/"]
   insteadOf = https://github.com/

[includeIf "gitdir:~/Projects/qdrant/"]
   path = ~/.config/git/qdrant

[color "diff"]
	meta = yellow
	frag = magenta
	old = red
	new = green
	commit = yellow
	whitespace = red reverse

[color "status"]
	added = green
	changed = yellow
	untracked = red
	branch = magenta

[color "branch"]
	current = yellow reverse
	local = yellow
	remote = green

[diff]
	algorithm = histogram
	colorMoved = plain
	mnemonicPrefix = true
	renames = true

[interactive]
	singleKey = true

[merge]
	conflictStyle = diff3
