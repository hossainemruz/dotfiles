{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": "notify",
  "enabled_providers": [
    "deepseek",
    "openai",
    "opencode-free"
  ],
  "provider": {
    "openai": {
      "options": {
        "setCacheKey": true
      }
    }
  },
  "lsp": true,
  "mcp": {
    "fff": {
      "type": "local",
      "command": [
        "fff-mcp"
      ]
    }
  },
  "small_model": "deepseek/deepseek-v4-flash",
  "subagent_depth": 2,
  "permission": {
    "todowrite": "deny",
    "read": {
      "~/.ssh/*": "deny",
      "~/.gnupg/*": "deny",
      "~/.aws/*": "deny",
      "~/.azure/*": "deny",
      "~/.kube/*": "deny",
      "~/.docker/*": "deny",
      "~/.config/gcloud/*": "deny",
      ".env*": "deny",
      "*/.env*": "deny",
      "*.pem": "deny",
      "*.key": "deny",
      "*.p12": "deny",
      "*.jks": "deny",
      "*credentials*": "deny"
    },
    "edit": {
      "~/.aws/*": "deny",
      "~/.azure/*": "deny",
      "~/.ssh/*": "deny",
      "~/.gnupg/*": "deny",
      "~/.kube/*": "deny",
      "~/.docker/*": "deny",
      "~/.config/gcloud/*": "deny",
      ".env*": "deny",
      "*/.env*": "deny",
      "*.pem": "deny",
      "*.key": "deny",
      "*.p12": "deny",
      "*.jks": "deny",
      "*credentials*": "deny"
    },
    "external_directory": {
      "/tmp/*": "allow",
      "~/.config/agent-workflows": "allow",
      "~/.config/agent-workflows/*": "allow",
      "~/.config/ghostty": "allow",
      "~/.config/ghostty/*": "allow",
      "~/.config/hunk": "allow",
      "~/.config/hunk/*": "allow",
      "~/.config/hypr": "allow",
      "~/.config/hypr/*": "allow",
      "~/.config/mise": "allow",
      "~/.config/mise/*": "allow",
      "~/.config/nvim": "allow",
      "~/.config/nvim/*": "allow",
      "~/.config/opencode": "allow",
      "~/.config/opencode/*": "allow",
      "~/.config/waybar": "allow",
      "~/.config/waybar/*": "allow",
      "~/agent-vault": "allow",
      "~/agent-vault/*": "allow"
    },
    "skill": {
      "omarchy": "deny",
      "plannotator-*": "deny"
    },
    "bash": {
      "curl *": "ask",
      "wget *": "ask",
      "ssh *": "ask",
      "scp *": "ask",
      "git push *": "ask",
      "brew install *": "ask",
      "npm publish *": "ask",
      "*.env*": "deny",
      "*.pem*": "deny",
      "*.key*": "deny",
      "*.p12*": "deny",
      "*.jks*": "deny",
      "*/.ssh/*": "deny",
      "*/.gnupg/*": "deny",
      "*/.aws/*": "deny",
      "*/.azure/*": "deny",
      "*/.kube/*": "deny",
      "*/.docker/*": "deny",
      "*/.config/gcloud/*": "deny",
      "rm *": "ask",
      "sudo rm *": "ask",
      "chmod -R *": "ask",
      "chmod 000 *": "ask",
      "chmod 0 *": "ask",
      "chown *": "ask",
      "sudo chown *": "ask",
      "dd *": "ask",
      "mkfs*": "ask",
      "shutdown*": "ask",
      "reboot*": "ask",
      "halt*": "ask",
      "poweroff*": "ask",
      "init 0*": "ask",
      "init 6*": "ask",
      "killall *": "ask",
      "pkill *": "ask",
      "kill -9 *": "ask",
      "git push --force*": "ask",
      "git push -f*": "ask",
      "git reset --hard*": "ask",
      "git clean -f*": "ask",
      "git checkout -- *": "ask",
      "git restore *": "ask"
    }
  },
  "model": "openai/gpt-5.6-terra",
  "default_agent": "general",
  "experimental": {
    "disable_paste_summary": true
  },
  "tool_output": {
    "max_lines": 300,
    "max_bytes": 12000
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "tail_turns": 3,
    "preserve_recent_tokens": 4000
  },
  "agent": {
    "plan": {
      "disable": true
    },
    "build": {
      "disable": true
    },
    "general": {
      "description": "Lean default primary agent for ordinary advice, investigation, and implementation",
      "model": "openai/gpt-5.6-sol",
      "mode": "primary",
      "variant": "medium",
      "permission": {
        "question": "allow",
        "todowrite": "allow",
        "bash": {
          "*taskctl*": "deny"
        },
        "task": {
          "*": "deny",
          "explore": "allow",
          "executor": "allow",
          "builder": "allow",
          "builder-high": "allow",
          "simplifier": "allow",
          "reviewer": "allow"
        }
      },
      "prompt": "{file:./prompts/engineering-voice.md}\n\n{file:./prompts/general-guideline.md}\n\n{file:./prompts/tool-routing.md}\n\n{file:./prompts/markdown-style.md}"
    },
    "orchestrator": {
      "description": "Task-focused primary control plane for taskctl lifecycle, review, and remediation",
      "model": "openai/gpt-5.6-terra",
      "mode": "primary",
      "variant": "high",
      "permission": {
        "question": "allow",
        "todowrite": "allow",
        "task": {
          "*": "deny",
          "planner": "allow",
          "explore": "allow",
          "executor": "allow",
          "workflow": "allow",
          "builder": "allow",
          "builder-high": "allow",
          "simplifier": "allow",
          "task-reviewer": "allow",
          "review-verifier": "allow",
          "expert-reviewer": "allow"
        }
      },
      "prompt": "{file:./prompts/engineering-voice.md}\n\n{file:./prompts/orchestrator-guideline.md}\n\n{file:./prompts/tool-routing.md}\n\n{file:./prompts/markdown-style.md}"
    },
    "builder": {
      "description": "Default implementation agent for well-scoped non-trivial coding",
      "model": "openai/gpt-5.6-sol",
      "mode": "subagent",
      "variant": "medium",
      "steps": 50,
      "permission": {
        "bash": {
          "*taskctl*": "deny"
        },
        "task": {
          "*": "deny",
          "explore": "allow",
          "executor": "allow"
        }
      },
      "prompt": "{file:./prompts/engineering-voice.md}\n\n{file:./prompts/builder-guideline.md}\n\n{file:./prompts/tool-routing.md}\n\n{file:./prompts/markdown-style.md}"
    },
    "builder-high": {
      "description": "High-effort implementation agent for security, data, compatibility, concurrency, architectural, or cross-system risk",
      "model": "openai/gpt-5.6-sol",
      "mode": "subagent",
      "variant": "high",
      "hidden": true,
      "steps": 50,
      "permission": {
        "bash": {
          "*taskctl*": "deny"
        },
        "task": {
          "*": "deny",
          "explore": "allow",
          "executor": "allow"
        }
      },
      "prompt": "{file:./prompts/engineering-voice.md}\n\n{file:./prompts/builder-guideline.md}\n\n{file:./prompts/tool-routing.md}\n\n{file:./prompts/markdown-style.md}"
    },
    "planner": {
      "description": "Research and structured implementation planning subagent",
      "model": "openai/gpt-5.6-sol",
      "mode": "subagent",
      "variant": "high",
      "permission": {
        "question": "allow",
        "edit": {
          "*": "deny",
          "~/agent-vault": "allow",
          "~/agent-vault/*": "allow",
          "*/agent-vault/projects/*": "allow"
        },
        "task": {
          "*": "deny",
          "explore": "allow",
          "executor": "allow"
        }
      },
      "prompt": "{file:./prompts/engineering-voice.md}\n\n{file:./skills/planning/SKILL.md}\n\n{file:./prompts/markdown-style.md}"
    },
    "explore": {
      "description": "Read-only codebase evidence retrieval; no implementation recommendations",
      "model": "deepseek/deepseek-v4-flash",
      "mode": "subagent",
      "variant": "max",
      "hidden": true,
      "steps": 25,
      "permission": {
        "edit": "deny",
        "bash": {
          "*taskctl*": "deny"
        },
        "task": "deny"
      },
      "prompt": "{file:./prompts/explore-guideline.md}\n\n{file:./prompts/tool-routing.md}"
    },
    "executor": {
      "description": "Default execution subagent for bash commands, tests, builds, and validation",
      "model": "deepseek/deepseek-v4-flash",
      "mode": "subagent",
      "hidden": true,
      "steps": 4,
      "permission": {
        "read": "deny",
        "edit": "deny",
        "glob": "deny",
        "grep": "deny",
        "list": "deny",
        "lsp": "deny",
        "webfetch": "deny",
        "websearch": "deny",
        "question": "deny",
        "skill": "deny",
        "todowrite": "deny",
        "fff_*": "deny",
        "bash": {
          "*taskctl*": "deny"
        },
        "task": "deny"
      },
      "prompt": "{file:./prompts/executor-guideline.md}"
    },
    "workflow": {
      "description": "Executes bounded taskctl lifecycle and status commands exactly as requested",
      "model": "deepseek/deepseek-v4-flash",
      "mode": "subagent",
      "hidden": true,
      "steps": 6,
      "permission": {
        "read": "deny",
        "edit": "deny",
        "glob": "deny",
        "grep": "deny",
        "list": "deny",
        "lsp": "deny",
        "webfetch": "deny",
        "websearch": "deny",
        "question": "deny",
        "skill": "deny",
        "todowrite": "deny",
        "fff_*": "deny",
        "bash": {
          "*": "deny",
          "taskctl *": "allow"
        },
        "task": "deny"
      },
      "prompt": "{file:./prompts/workflow-guideline.md}"
    },
    "simplifier": {
      "description": "Review changed code for reuse, quality, and efficiency, then fix worthwhile issues",
      "model": "openai/gpt-5.6-luna",
      "variant": "max",
      "mode": "subagent",
      "hidden": true,
      "permission": {
        "task": {
          "*": "deny",
          "executor": "allow"
        }
      },
      "prompt": "{file:./skills/simplify/SKILL.md}\n\n{file:./prompts/markdown-style.md}"
    },
    "reviewer": {
      "description": "Ad hoc source-read-only review of caller-scoped or working-tree changes",
      "model": "openai/gpt-5.6-sol",
      "variant": "high",
      "mode": "subagent",
      "hidden": true,
      "steps": 40,
      "permission": {
        "bash": {
          "*taskctl*": "deny"
        },
        "edit": "deny",
        "task": {
          "*": "deny",
          "explore": "allow",
          "executor": "allow"
        }
      },
      "prompt": "{file:./prompts/engineering-voice.md}\n\n{file:./skills/code-review/SKILL.md}"
    },
    "task-reviewer": {
      "description": "Full-PR Task review that records remediation-enabled findings in review.md",
      "model": "openai/gpt-5.6-sol",
      "variant": "high",
      "mode": "subagent",
      "hidden": true,
      "steps": 40,
      "permission": {
        "bash": {
          "*taskctl*": "deny"
        },
        "edit": {
          "*": "deny",
          ".work/*": "allow",
          "~/agent-vault": "allow",
          "~/agent-vault/*": "allow",
          "*/agent-vault/projects/*": "allow"
        },
        "task": {
          "*": "deny",
          "explore": "allow",
          "executor": "allow"
        }
      },
      "prompt": "{file:./prompts/engineering-voice.md}\n\n{file:./skills/code-review/SKILL.md}\n\n{file:./prompts/task-review-guideline.md}\n\n{file:./prompts/markdown-style.md}"
    },
    "review-verifier": {
      "description": "Pre-submission verification of in-progress Task PR review remediation",
      "model": "deepseek/deepseek-v4-flash",
      "variant": "max",
      "mode": "subagent",
      "hidden": true,
      "steps": 40,
      "permission": {
        "bash": {
          "*taskctl*": "deny"
        },
        "edit": {
          "*": "deny",
          ".work/*": "allow",
          "~/agent-vault": "allow",
          "~/agent-vault/*": "allow",
          "*/agent-vault/projects/*": "allow"
        },
        "task": {
          "*": "deny",
          "executor": "allow"
        }
      },
      "prompt": "{file:./prompts/review-verifier-guideline.md}\n\n{file:./prompts/markdown-style.md}"
    },
    "expert-reviewer": {
      "description": "Expert-depth source-read-only review for Task PRs or ad hoc scopes",
      "model": "openai/gpt-5.6-sol",
      "variant": "xhigh",
      "mode": "subagent",
      "hidden": true,
      "steps": 50,
      "permission": {
        "bash": {
          "*taskctl*": "deny"
        },
        "edit": {
          "*": "deny",
          ".work/*": "allow",
          "~/agent-vault": "allow",
          "~/agent-vault/*": "allow",
          "*/agent-vault/projects/*": "allow"
        },
        "task": {
          "*": "deny",
          "explore": "allow",
          "executor": "allow"
        }
      },
      "prompt": "{file:./skills/code-review/SKILL.md}\n\n{file:./prompts/task-review-guideline.md}\n\n{file:./prompts/expert-reviewer-guideline.md}\n\n{file:./prompts/markdown-style.md}"
    }
  }
}
