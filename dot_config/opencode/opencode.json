{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": "notify",
  "provider": {
    "openai": {
      "options": {
        "setCacheKey": true
      }
    }
  },
  "lsp": true,
  "mcp": {
    "fff": {
      "type": "local",
      "command": [
        "fff-mcp"
      ]
    },
    "devcroft": {
      "type": "remote",
      "url": "http://127.0.0.1:8756/mcp",
      "enabled": true
    }
  },
  "small_model": "deepseek/deepseek-v4-flash",
  "subagent_depth": 2,
  "permission": {
    "devcroft_*": "deny",
    "todowrite": "deny",
    "read": {
      "~/.ssh/*": "deny",
      "~/.gnupg/*": "deny",
      "~/.aws/*": "deny",
      "~/.azure/*": "deny",
      "~/.kube/*": "deny",
      "~/.docker/*": "deny",
      "~/.config/gcloud/*": "deny",
      ".env*": "deny",
      "*/.env*": "deny",
      "*.pem": "deny",
      "*.key": "deny",
      "*.p12": "deny",
      "*.jks": "deny",
      "*credentials*": "deny"
    },
    "edit": {
      "~/.aws/*": "deny",
      "~/.azure/*": "deny",
      "~/.ssh/*": "deny",
      "~/.gnupg/*": "deny",
      "~/.kube/*": "deny",
      "~/.docker/*": "deny",
      "~/.config/gcloud/*": "deny",
      ".env*": "deny",
      "*/.env*": "deny",
      "*.pem": "deny",
      "*.key": "deny",
      "*.p12": "deny",
      "*.jks": "deny",
      "*credentials*": "deny"
    },
    "external_directory": {
      "/tmp/*": "allow",
      "~/.config/agent-workflows": "allow",
      "~/.config/agent-workflows/*": "allow",
      "~/.config/ghostty": "allow",
      "~/.config/ghostty/*": "allow",
      "~/.config/hunk": "allow",
      "~/.config/hunk/*": "allow",
      "~/.config/hypr": "allow",
      "~/.config/hypr/*": "allow",
      "~/.config/mise": "allow",
      "~/.config/mise/*": "allow",
      "~/.config/nvim": "allow",
      "~/.config/nvim/*": "allow",
      "~/.config/opencode": "allow",
      "~/.config/opencode/*": "allow",
      "~/.config/waybar": "allow",
      "~/.config/waybar/*": "allow"
    },
    "skill": {
      "omarchy": "deny",
      "plannotator-*": "deny"
    },
    "bash": {
      "curl *": "ask",
      "wget *": "ask",
      "ssh *": "ask",
      "scp *": "ask",
      "git push *": "ask",
      "brew install *": "ask",
      "npm publish *": "ask",
      "*.env*": "deny",
      "*.pem*": "deny",
      "*.key*": "deny",
      "*.p12*": "deny",
      "*.jks*": "deny",
      "*/.ssh/*": "deny",
      "*/.gnupg/*": "deny",
      "*/.aws/*": "deny",
      "*/.azure/*": "deny",
      "*/.kube/*": "deny",
      "*/.docker/*": "deny",
      "*/.config/gcloud/*": "deny",
      "rm *": "ask",
      "sudo rm *": "ask",
      "chmod -R *": "ask",
      "chmod 000 *": "ask",
      "chmod 0 *": "ask",
      "chown *": "ask",
      "sudo chown *": "ask",
      "dd *": "ask",
      "mkfs*": "ask",
      "shutdown*": "ask",
      "reboot*": "ask",
      "halt*": "ask",
      "poweroff*": "ask",
      "init 0*": "ask",
      "init 6*": "ask",
      "killall *": "ask",
      "pkill *": "ask",
      "kill -9 *": "ask",
      "git push --force*": "ask",
      "git push -f*": "ask",
      "git reset --hard*": "ask",
      "git clean -f*": "ask",
      "git checkout -- *": "ask",
      "git restore *": "ask"
    }
  },
  "model": "openai/gpt-5.6-terra",
  "default_agent": "general",
  "experimental": {
    "disable_paste_summary": true
  },
  "tool_output": {
    "max_lines": 300,
    "max_bytes": 12000
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "tail_turns": 3,
    "preserve_recent_tokens": 4000
  },
  "agent": {
    "plan": {
      "disable": true
    },
    "build": {
      "disable": true
    },
    "general": {
      "description": "Default primary agent for unplanned advice, investigation, review, and ad-hoc implementation",
      "model": "openai/gpt-5.6-terra",
      "mode": "primary",
      "variant": "high",
      "permission": {
        "question": "allow",
        "todowrite": "allow",
        "task": {
          "*": "deny",
          "explore": "allow",
          "advisor": "allow",
          "executor": "allow",
          "builder": "allow",
          "builder-high": "allow",
          "reviewer": "allow",
          "expert-reviewer": "allow"
        }
      },
      "prompt": "{file:./prompts/engineering-voice.md}\n\n{file:./prompts/general-guideline.md}\n\n{file:./prompts/context-handoff.md}\n\n{file:./prompts/tool-routing.md}\n\n{file:./prompts/markdown-style.md}"
    },
    "orchestrator": {
      "description": "Primary control plane for explicit planning and planned Devcroft Task lifecycle",
      "model": "openai/gpt-5.6-terra",
      "mode": "primary",
      "variant": "high",
      "permission": {
        "devcroft_*": "allow",
        "question": "allow",
        "todowrite": "allow",
        "task": {
          "*": "deny",
          "planner": "allow",
          "explore": "allow",
          "advisor": "allow",
          "executor": "allow",
          "builder": "allow",
          "builder-high": "allow",
          "reviewer": "allow",
          "expert-reviewer": "allow"
        }
      },
      "prompt": "{file:./prompts/engineering-voice.md}\n\n{file:./prompts/orchestrator-guideline.md}\n\n{file:./prompts/devcroft-guideline.md}\n\n{file:./prompts/context-handoff.md}\n\n{file:./prompts/tool-routing.md}\n\n{file:./prompts/markdown-style.md}"
    },
    "builder": {
      "description": "Default implementation agent for clear bounded workflow or ad-hoc coding",
      "model": "deepseek/deepseek-v4-flash",
      "mode": "subagent",
      "hidden": true,
      "steps": 50,
      "permission": {
        "question": "deny",
        "read": {
          ".work/*": "deny"
        },
        "edit": {
          ".work/*": "deny"
        },
        "task": "deny"
      },
      "prompt": "{file:./prompts/engineering-voice.md}\n\n{file:./prompts/builder-guideline.md}\n\n{file:./prompts/tool-routing.md}\n\n{file:./prompts/markdown-style.md}"
    },
    "builder-high": {
      "description": "High-capability implementation agent for difficult, cross-cutting, or reasoning-intensive coding",
      "model": "openai/gpt-5.6-terra",
      "mode": "subagent",
      "variant": "xhigh",
      "hidden": true,
      "steps": 50,
      "permission": {
        "question": "deny",
        "read": {
          ".work/*": "deny"
        },
        "edit": {
          ".work/*": "deny"
        },
        "task": "deny"
      },
      "prompt": "{file:./prompts/engineering-voice.md}\n\n{file:./prompts/builder-guideline.md}\n\n{file:./prompts/tool-routing.md}\n\n{file:./prompts/markdown-style.md}"
    },
    "advisor": {
      "description": "Read-only implementation advisor for unresolved architectural, security, or high-stakes decisions",
      "model": "openai/gpt-5.6-sol",
      "mode": "subagent",
      "variant": "high",
      "hidden": true,
      "steps": 25,
      "permission": {
        "question": "deny",
        "read": {
          ".work/*": "deny"
        },
        "edit": "deny",
        "bash": {
          "*": "deny",
          "git diff": "allow",
          "git diff *": "allow"
        },
        "task": "deny"
      },
      "prompt": "{file:./prompts/engineering-voice.md}\n\n{file:./prompts/advisor-guideline.md}\n\n{file:./prompts/tool-routing.md}\n\n{file:./prompts/markdown-style.md}"
    },
    "planner": {
      "description": "Research and structured implementation planning subagent",
      "model": "openai/gpt-5.6-sol",
      "mode": "subagent",
      "variant": "xhigh",
      "hidden": true,
      "permission": {
        "question": "deny",
        "read": {
          ".work/*": "deny"
        },
        "edit": "deny",
        "bash": {
          "*": "deny",
          "git diff": "allow",
          "git diff *": "allow"
        },
        "task": "deny"
      },
      "prompt": "{file:./prompts/engineering-voice.md}\n\n{file:./skills/planning/SKILL.md}\n\n{file:./prompts/tool-routing.md}\n\n{file:./prompts/markdown-style.md}"
    },
    "explore": {
      "description": "Read-only codebase evidence retrieval; no implementation recommendations",
      "model": "deepseek/deepseek-v4-flash",
      "mode": "subagent",
      "hidden": true,
      "steps": 25,
      "permission": {
        "question": "deny",
        "read": {
          ".work/*": "deny"
        },
        "edit": "deny",
        "bash": {
          "*": "deny"
        },
        "task": "deny"
      },
      "prompt": "{file:./prompts/explore-guideline.md}\n\n{file:./prompts/tool-routing.md}"
    },
    "executor": {
      "description": "Default execution subagent for bash commands, tests, builds, and validation",
      "model": "openai/gpt-5.6-luna",
      "mode": "subagent",
      "hidden": true,
      "variant": "medium",
      "steps": 4,
      "permission": {
        "read": "deny",
        "edit": "deny",
        "glob": "deny",
        "grep": "deny",
        "list": "deny",
        "lsp": "deny",
        "webfetch": "deny",
        "websearch": "deny",
        "question": "deny",
        "skill": "deny",
        "todowrite": "deny",
        "fff_*": "deny",
        "task": "deny"
      },
      "prompt": "{file:./prompts/executor-guideline.md}"
    },
    "reviewer": {
      "description": "Default independent source-read-only reviewer for workflow and ad hoc changes",
      "model": "openai/gpt-5.6-terra",
      "variant": "xhigh",
      "mode": "subagent",
      "hidden": true,
      "steps": 40,
      "permission": {
        "question": "deny",
        "read": {
          ".work/*": "deny"
        },
        "bash": {
          "*": "deny",
          "git diff": "allow",
          "git diff *": "allow",
          "git status --short": "allow",
          "git status --short *": "allow",
          "git log": "allow",
          "git log *": "allow"
        },
        "edit": "deny",
        "task": "deny"
      },
      "prompt": "{file:./prompts/engineering-voice.md}\n\n{file:./skills/code-review/SKILL.md}\n\n{file:./prompts/task-review-guideline.md}\n\n{file:./prompts/tool-routing.md}\n\n{file:./prompts/markdown-style.md}"
    },
    "expert-reviewer": {
      "description": "Expert-depth source-read-only review for workflow Subtasks or ad hoc scopes",
      "model": "openai/gpt-5.6-sol",
      "variant": "high",
      "mode": "subagent",
      "hidden": true,
      "steps": 50,
      "permission": {
        "question": "deny",
        "read": {
          ".work/*": "deny"
        },
        "bash": {
          "*": "deny",
          "git diff": "allow",
          "git diff *": "allow",
          "git status --short": "allow",
          "git status --short *": "allow",
          "git log": "allow",
          "git log *": "allow"
        },
        "edit": "deny",
        "task": "deny"
      },
      "prompt": "{file:./prompts/engineering-voice.md}\n\n{file:./skills/code-review/SKILL.md}\n\n{file:./prompts/task-review-guideline.md}\n\n{file:./prompts/expert-reviewer-guideline.md}\n\n{file:./prompts/tool-routing.md}\n\n{file:./prompts/markdown-style.md}"
    }
  }
}
