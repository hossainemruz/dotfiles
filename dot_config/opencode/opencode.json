{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": "notify",
  "provider": {
    "openai": {
      "options": {
        "setCacheKey": true
      }
    }
  },
  "lsp": true,
  "mcp": {
    "fff": {
      "type": "local",
      "command": [
        "fff-mcp"
      ]
    },
    "cua-driver": {
      "type": "local",
      "command": [
        "/Users/emruz/.local/bin/cua-driver",
        "mcp"
      ],
      "enabled": true
    }
  },
  "small_model": "opencode-go/deepseek-v4.1-flash",
  "subagent_depth": 2,
  "permission": {
    "todowrite": "deny",
    "read": {
      "~/.ssh/*": "deny",
      "~/.gnupg/*": "deny",
      "~/.aws/*": "deny",
      "~/.azure/*": "deny",
      "~/.kube/*": "deny",
      "~/.docker/*": "deny",
      "~/.config/gcloud/*": "deny",
      ".env*": "deny",
      "*/.env*": "deny",
      "*.pem": "deny",
      "*.key": "deny",
      "*.p12": "deny",
      "*.jks": "deny",
      "*credentials*": "deny"
    },
    "edit": {
      "~/.aws/*": "deny",
      "~/.azure/*": "deny",
      "~/.ssh/*": "deny",
      "~/.gnupg/*": "deny",
      "~/.kube/*": "deny",
      "~/.docker/*": "deny",
      "~/.config/gcloud/*": "deny",
      ".env*": "deny",
      "*/.env*": "deny",
      "*.pem": "deny",
      "*.key": "deny",
      "*.p12": "deny",
      "*.jks": "deny",
      "*credentials*": "deny"
    },
    "external_directory": {
      "/tmp/*": "allow",
      "/private/tmp/*": "allow",
      "/var/folders/*/T/devcroft-review-*/*": "allow",
      "~/.config/ghostty": "allow",
      "~/.config/ghostty/*": "allow",
      "~/.config/hunk": "allow",
      "~/.config/hunk/*": "allow",
      "~/.config/hypr": "allow",
      "~/.config/hypr/*": "allow",
      "~/.config/mise": "allow",
      "~/.config/mise/*": "allow",
      "~/.config/nvim": "allow",
      "~/.config/nvim/*": "allow",
      "~/.config/opencode": "allow",
      "~/.config/opencode/*": "allow",
      "~/.config/waybar": "allow",
      "~/.config/waybar/*": "allow"
    },
    "skill": {
      "omarchy": "deny"
    },
    "bash": {
      "curl *": "ask",
      "wget *": "ask",
      "ssh *": "ask",
      "scp *": "ask",
      "git push *": "ask",
      "brew install *": "ask",
      "npm publish *": "ask",
      "*.env": "deny",
      "*.env.*": "deny",
      "*/.env*": "deny",
      "*.pem": "deny",
      "*.pem.*": "deny",
      "*.key": "deny",
      "*.key.*": "deny",
      "*.p12": "deny",
      "*.jks": "deny",
      "*/.ssh/*": "deny",
      "*/.gnupg/*": "deny",
      "*/.aws/*": "deny",
      "*/.azure/*": "deny",
      "*/.kube/*": "deny",
      "*/.docker/*": "deny",
      "*/.config/gcloud/*": "deny",
      "rm *": "ask",
      "sudo rm *": "ask",
      "chmod -R *": "ask",
      "chmod 000 *": "ask",
      "chmod 0 *": "ask",
      "chown *": "ask",
      "sudo chown *": "ask",
      "dd *": "ask",
      "mkfs*": "ask",
      "shutdown*": "ask",
      "reboot*": "ask",
      "halt*": "ask",
      "poweroff*": "ask",
      "init 0*": "ask",
      "init 6*": "ask",
      "killall *": "ask",
      "pkill *": "ask",
      "kill -9 *": "ask",
      "git push --force*": "ask",
      "git push -f*": "ask",
      "git reset --hard*": "ask",
      "git clean -f*": "ask",
      "git checkout -- *": "ask",
      "git restore *": "ask"
    }
  },
  "model": "opencode-go/deepseek-v4.1-flash",
  "default_agent": "general",
  "experimental": {
    "disable_paste_summary": true
  },
  "tool_output": {
    "max_lines": 300,
    "max_bytes": 12000
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "tail_turns": 6,
    "preserve_recent_tokens": 8000
  },
  "agent": {
    "plan": {
      "disable": true
    },
    "build": {
      "disable": true
    },
    "general": {
      "description": "Default primary agent for advice, investigation, review, and ad-hoc implementation",
      "model": "opencode-go/deepseek-v4.1-flash",
      "mode": "primary",
      "variant": "max",
      "permission": {
        "question": "allow",
        "todowrite": "allow",
        "task": {
          "*": "deny",
          "explore": "allow",
          "reviewer": "allow",
          "expert-reviewer": "allow"
        }
      },
      "prompt": "{file:./prompts/engineering-voice.md}\n\n{file:./prompts/general-guideline.md}\n\n{file:./prompts/context-handoff.md}\n\n{file:./prompts/tool-routing.md}\n\n{file:./prompts/markdown-style.md}"
    },
    "explore": {
      "description": "Read-only codebase evidence retrieval; no implementation recommendations",
      "model": "opencode-go/deepseek-v4.1-flash",
      "variant": "high",
      "mode": "subagent",
      "hidden": true,
      "steps": 25,
      "permission": {
        "question": "deny",
        "edit": "deny",
        "bash": {
          "*": "deny"
        },
        "task": "deny"
      },
      "prompt": "{file:./prompts/explore-guideline.md}\n\n{file:./prompts/tool-routing.md}"
    },
    "reviewer": {
      "description": "Independent source-read-only reviewer for ad-hoc changes",
      "model": "opencode-go/deepseek-v4.1-flash",
      "variant": "max",
      "mode": "subagent",
      "hidden": true,
      "steps": 80,
      "permission": {
        "question": "deny",
        "bash": {
          "*": "deny",
          "git diff": "allow",
          "git diff *": "allow",
          "git status --short": "allow",
          "git status --short *": "allow",
          "git log": "allow",
          "git log *": "allow"
        },
        "edit": "deny",
        "task": "deny"
      },
      "prompt": "{file:./prompts/engineering-voice.md}\n\n{file:./skills/code-review/SKILL.md}\n\n{file:./prompts/tool-routing.md}\n\n{file:./prompts/markdown-style.md}"
    },
    "expert-reviewer": {
      "description": "Expert source-read-only reviewer for high-impact changes",
      "model": "openai/gpt-6.1-sol",
      "variant": "xhigh",
      "mode": "subagent",
      "hidden": true,
      "steps": 80,
      "permission": {
        "question": "deny",
        "bash": {
          "*": "deny",
          "git diff": "allow",
          "git diff *": "allow",
          "git status --short": "allow",
          "git status --short *": "allow",
          "git log": "allow",
          "git log *": "allow"
        },
        "edit": "deny",
        "task": "deny"
      },
      "prompt": "{file:./prompts/engineering-voice.md}\n\n{file:./skills/code-review/SKILL.md}\n\n{file:./prompts/tool-routing.md}\n\n{file:./prompts/markdown-style.md}"
    }
  }
}
