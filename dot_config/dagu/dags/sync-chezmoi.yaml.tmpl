name: sync-chezmoi
schedule: "*/15 * * * *"
overlap_policy: skip
env:
  - PATH: "${HOME}/.local/bin:${HOME}/.local/share/mise/shims:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin"
  - REPOSITORY: {{ .chezmoi.sourceDir | quote }}
steps:
  - id: sync
    run: sync-git-repo "$REPOSITORY"
handler_on:
  failure:
    run: notify-sync-failure "chezmoi sync failed" "Automatic sync failed for $REPOSITORY. Inspect the Dagu logs, or start 'dagu server' to use the web UI; a rebase conflict may require manual resolution."
